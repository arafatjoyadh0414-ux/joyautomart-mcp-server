{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "com.joyautomart/mcp",
  "title": "JOY Automart",
  "description": "Search automotive parts and used/reconditioned vehicle listings in Bangladesh (BDT prices, stock, fitment).",
  "version": "1.2.0",
  "websiteUrl": "https://www.joyautomart.com/developers",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.joyautomart.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional buyer token: 'Bearer joyagt_...'",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@joyautomart/mcp-server",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JOY_AGENT_TOKEN",
          "description": "Optional buyer token (joyagt_...)",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/arafatjoyadh0414-ux/joyautomart-mcp-server",
    "source": "github"
  }
}